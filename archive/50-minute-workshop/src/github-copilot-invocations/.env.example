# Local-only alternative to azd environment injection. Never commit a real .env.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
VOLT_VARIANT=improved
# Get this from the project's connected resource; do not put a real value here.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# No GITHUB_TOKEN: this implementation uses only the Foundry BYOK model path.
